rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTerm(data) {
      return data.keys().hasAll(['term', 'category', 'definition', 'importance']) &&
             data.keys().hasOnly(['term', 'category', 'subCategory', 'subcategory', 'definition', 'importance', 'id', 'page', 'example', 'examTip', 'synonyms', 'relatedTerms', 'authorId', 'createdAt', 'updatedAt']) &&
             data.term is string && data.term.size() > 0 && data.term.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
             (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() <= 60)) &&
             (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 60)) &&
             data.definition is string && data.definition.size() > 0 && data.definition.size() <= 2000 &&
             data.importance in ['essencial', 'importante', 'complementar'] &&
             (!('page' in data) || (data.page is number && data.page >= 1 && data.page <= 200)) &&
             (!('example' in data) || (data.example is string && data.example.size() <= 500)) &&
             (!('examTip' in data) || (data.examTip is string && data.examTip.size() <= 500));
    }

    function isValidBookmark(data, userId, termId) {
      return data.keys().hasAll(['termId', 'userId']) &&
             data.keys().hasOnly(['termId', 'userId', 'createdAt']) &&
             data.userId == userId &&
             data.termId == termId &&
             data.termId is string && data.termId.size() <= 128;
    }

    function isValidNote(data, userId, termId) {
      return data.keys().hasAll(['termId', 'userId', 'note']) &&
             data.keys().hasOnly(['termId', 'userId', 'note', 'updatedAt']) &&
             data.userId == userId &&
             data.termId == termId &&
             data.note is string && data.note.size() > 0 && data.note.size() <= 1500;
    }

    // Match rules for nautical terms
    match /terms/{termId} {
      allow get, list: if true;
      allow create: if isValidId(termId) && isValidTerm(incoming());
      allow update: if isValidId(termId) && isValidTerm(incoming());
      allow delete: if isSignedIn() && (request.auth.token.email == 'nunoveloso18@gmail.com');
    }

    // Match rules for user-isolated data
    match /users/{userId} {
      allow get, list: if isOwner(userId);

      match /bookmarks/{termId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(termId) && isValidBookmark(incoming(), userId, termId);
        allow delete: if isOwner(userId) && isValidId(termId);
      }

      match /notes/{termId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(termId) && isValidNote(incoming(), userId, termId);
        allow update: if isOwner(userId) && isValidId(termId) && isValidNote(incoming(), userId, termId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(termId);
      }

      match /exam_attempts/{attemptId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(attemptId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
